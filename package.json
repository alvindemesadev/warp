{
  "name": "warp",
  "version": "2.0.0",
  "description": "High-speed file transfer desktop app",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && node scripts/check.js",
    "check:versions": "node scripts/check-versions.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "build:win": "node scripts/build.js",
    "release": "node scripts/release.js",
    "release:apply": "node scripts/release.js --apply",
    "tauri": "tauri",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "fix": "prettier --write . && eslint . --fix && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm run check && npm run test:coverage && cargo fmt --check --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings && cargo test --lib --manifest-path src-tauri/Cargo.toml",
    "bench:rust": "cargo bench --manifest-path src-tauri/Cargo.toml",
    "test:a11y": "playwright test e2e/a11y.spec.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
